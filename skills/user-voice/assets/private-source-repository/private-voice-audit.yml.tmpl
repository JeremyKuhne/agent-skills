name: Private voice audit

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Audit private voice source
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: >-
          ./.private-voice/Test-UserVoiceRepository.ps1
          -RepositoryPath .
          -RequirePrivateGitHub
          -ScanHistory

      - name: Audit private runtime package
        shell: pwsh
        run: >-
          ./.private-voice/Test-UserVoiceProfile.ps1
          -ProfilePath ./user-voice-profile
          -AllowDraft