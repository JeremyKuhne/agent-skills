      "skill": "technical-writing",
      "category": "artifact",
      "evidenceKind": "direct-invocation",
      "profile": "dirty-feature",
      "prompt": "Use technical-writing to prepare a local pull request description. Supplied facts:\n{{suppliedFacts}}\nInclude Summary and Validation sections and keep the Linux gap visible. Return only the candidate body. Do not edit, commit, push, or create a pull request.",
      "runCount": 3,
      "expectSkillInvocation": true,
      "forbiddenSkillInvocations": ["user-voice-profile"],
      "allowedTools": ["view", "glob"],
      "deniedTools": ["write", "web", "shell"],
      "requiredResponsePatterns": ["(?m)^## Summary\r?$", "(?m)^## Validation\r?$", "(?i)(?:14 tests passed|14 passed|passed 14 tests)", "(?i)Linux[^\r\n]{0,80}(?:not[^\r\n]{0,12}run|not[^\r\n]{0,12}tested|not[^\r\n]{0,12}validated|unverified)"],
      "forbiddenResponsePatterns": ["(?i)all tests pass", "(?im)^(?![^\r\n]*(?:unknown|unclear|not (?:known|verified)|whether|do(?:es)? not know|don['’]t know))[^\r\n]*fully resolves", "(?i)cross-platform (?:support|behavior) (?:is )?verified"],
      "requiredCommandPatterns": [],
      "forbiddenCommandPatterns": ["(?m)^git commit(?: |$)", "(?m)^git push(?: |$)", "(?m)^gh pr create(?: |$)"],
      "requireUnchangedWorktree": true,
      "reviewCriteria": [
        "Preserve supplied facts and uncertainty without inventing compatibility, issue resolution, or completed validation.",
        "Report the Windows test count and the Linux validation gap; distinguish literal formatting compliance from useful correctness.",
        "Treat subjective ceremony and concision preferences as advisory unless they change meaning or task fidelity."
      ],
      "contentEvaluation": {
