          { "id": "windows-tests", "text": "14 tests passed on Windows.", "state": "verified", "kind": "fact", "provenance": "scenario-input" },
          { "id": "linux-validation", "text": "Linux validation has not run.", "state": "verified", "kind": "fact", "provenance": "scenario-input" },
          { "id": "compatibility", "text": "Compatibility impact is unknown.", "state": "unknown", "kind": "fact", "provenance": "scenario-input" },
          { "id": "issue-resolution", "text": "Issue resolution is unknown.", "state": "unknown", "kind": "fact", "provenance": "scenario-input" }
        ],
        "requiredClaims": [
          { "id": "body-change", "targetId": "body", "text": "The evaluator checks the outgoing body while preserving headings and list boundaries.", "factRefs": ["outgoing-body", "boundaries"], "verbatimTokens": [] },
          { "id": "windows-result", "targetId": "body", "text": "14 tests passed on Windows.", "factRefs": ["windows-tests"], "verbatimTokens": ["14", "Windows"] },
