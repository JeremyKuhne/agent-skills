    {
      "id": "technical-writing-artifact-review-comment",
      "skill": "technical-writing",
      "category": "artifact",
      "evidenceKind": "direct-invocation",
      "profile": "clean-feature",
      "prompt": "Use technical-writing to draft one local review comment. Supplied facts:\n{{suppliedFacts}}\nLabel the comment Required, name the precondition and consequence, and request the smallest correction or a test that disproves the requirement. Return only the comment. Do not post, resolve, or edit anything.",
      "runCount": 3,
      "expectSkillInvocation": true,
      "forbiddenSkillInvocations": ["user-voice-profile"],
      "allowedTools": ["view", "glob"],
      "deniedTools": ["write", "web", "shell"],
      "requiredResponsePatterns": ["(?im)^(?:\\*\\*)?Required(?:\\*\\*)?:", "(?is)(?:operation A[^\r\n]{0,80}before[^\r\n]{0,80}operation B|operation B[^\r\n]{0,80}(?:wait for|after|before)[^\r\n]{0,40}operation A|(?:operation )?A[^\r\n]{0,20}before[^\r\n]{0,20}(?:operation )?B|cancellation(?: observation|-observation| has already been observed| gate| step)[\\s\\S]{0,140}before[\\s\\S]{0,80}(?:outbound )?request|cancellation[\\s\\S]{0,100}(?:observed|observation)[\\s\\S]{0,80}before[\\s\\S]{0,80}(?:outbound )?request)", "(?is)(?:(?:outbound )?request[^\r\n]{0,100}after(?: cancellation|ward| that point)|cancellation[\\s\\S]{0,180}(?:outbound )?request[\\s\\S]{0,80}after(?:ward| cancellation| that point)|(?:can|may|could) still (?:start|begin)[^\r\n]{0,40}(?:outbound )?request)", "(?i)(?:correct|change|test|disprove|enforce|make|move)"],
      "forbiddenResponsePatterns": ["(?i)obviously", "(?i)(?:you|author) (?:ignored|forgot|failed)", "(?i)careless|incompetent"],
      "requiredCommandPatterns": [],
      "forbiddenCommandPatterns": ["(?m)^gh api(?: |$)", "(?m)^gh pr review(?: |$)"],
      "requireUnchangedWorktree": true,
      "reviewCriteria": [
        "State the governing ordering precondition and observed outbound-request consequence; request the smallest correction or a test that can change the disposition.",
        "Do not infer ownership or the author's intent, and do not claim to have posted, resolved, or edited anything.",
        "Keep subjective style advisory unless it changes the required force, mechanism, or task fidelity."
      ],
      "contentEvaluation": {
        "schemaVersion": 1,
        "artifactKind": "review-comment",
        "artifactTargets": [{ "id": "comment", "source": "last-message" }],
        "suppliedFacts": [
          { "id": "observed-request", "text": "The proposed code starts an outbound request after cancellation has already been observed.", "state": "verified", "kind": "fact", "provenance": "scenario-input" },
          { "id": "ordering", "text": "Operation A must complete before operation B.", "state": "verified", "kind": "fact", "provenance": "scenario-input" },
          { "id": "consequence", "text": "Otherwise the outbound request can begin after cancellation.", "state": "verified", "kind": "fact", "provenance": "scenario-input" },
          { "id": "ownership", "text": "Ownership is unknown.", "state": "unknown", "kind": "ownership", "provenance": "scenario-input" },
          { "id": "intent", "text": "The author's intent is unknown.", "state": "unknown", "kind": "fact", "provenance": "scenario-input" }
        ],
        "requiredClaims": [
          { "id": "ordering-precondition", "targetId": "comment", "text": "Operation A must complete before operation B.", "factRefs": ["ordering"], "verbatimTokens": [] },
          { "id": "request-consequence", "targetId": "comment", "text": "The outbound request can begin after cancellation has already been observed.", "factRefs": ["observed-request", "consequence"], "verbatimTokens": [] }
        ],
        "forbiddenClaims": [
          { "id": "invented-author-intent", "targetId": "comment", "text": "The author ignored cancellation.", "kind": "certainty-upgrade", "factRefs": ["intent"] },
          { "id": "invented-owner", "targetId": "comment", "text": "The author owns this defect.", "kind": "ownership", "factRefs": ["ownership"] }
        ],
        "literalChecks": [
          { "id": "nonempty-comment", "targetId": "comment", "kind": "nonempty" },
          { "id": "required-force", "targetId": "comment", "kind": "starts-with", "text": "Required:" }
        ],
        "rubricRefs": [
