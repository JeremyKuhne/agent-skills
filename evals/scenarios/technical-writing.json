          { "id": "invented-cross-platform-validation", "targetId": "body", "text": "Cross-platform behavior is verified.", "kind": "test-status", "factRefs": ["linux-validation"] },
          { "id": "invented-compatibility", "targetId": "body", "text": "The change is fully compatible.", "kind": "certainty-upgrade", "factRefs": ["compatibility"] }
        ],
        "literalChecks": [
