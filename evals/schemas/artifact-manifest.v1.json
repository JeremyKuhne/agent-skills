{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "runNumber", "scenarioRevision", "profileRevision", "inputRevision", "modelOutputRevision", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "runNumber": { "type": "integer", "minimum": 1 },
    "scenarioRevision": { "$ref": "#/$defs/revision" },
    "profileRevision": { "$ref": "#/$defs/revision" },
    "inputRevision": { "$ref": "#/$defs/revision" },
    "modelOutputRevision": { "$ref": "#/$defs/revision" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "source", "sourcePath", "storedPath", "encoding", "sha256", "assistantEventLine"],
        "properties": {
          "targetId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "source": { "enum": ["last-message", "file"] },
          "sourcePath": { "type": ["string", "null"] },
          "storedPath": { "type": "string", "minLength": 1 },
          "encoding": { "enum": ["utf-8", "utf-8-bom"] },
          "sha256": { "$ref": "#/$defs/revision" },
          "assistantEventLine": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
  }
}
