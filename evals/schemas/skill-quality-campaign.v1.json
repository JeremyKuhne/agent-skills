{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "criteriaRevision", "expectedSkillIds", "criteria", "expectedRunInventory", "actualRunRecords", "judgeRecords"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campaignId": { "$ref": "#/$defs/nonEmptyText" },
    "criteriaRevision": { "$ref": "#/$defs/sha256" },
    "expectedSkillIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "minItems": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "itemId", "hardGate"],
        "properties": {
          "skillId": { "$ref": "#/$defs/id" },
          "itemId": { "$ref": "#/$defs/id" },
          "hardGate": { "type": "boolean" }
        }
      }
    },
    "expectedRunInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/runRecord" },
          {
            "properties": {
              "status": { "const": "scheduled" },
              "artifactRevision": { "const": null },
              "safety": { "const": "pending" },
              "infrastructure": { "const": "pending" },
              "oracleOutcome": { "const": null },
              "hardChecks": { "maxItems": 0 },
              "usage": { "const": null },
              "elapsedMs": { "const": null }
            }
          }
        ]
      }
    },
    "actualRunRecords": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/runRecord" },
          { "properties": { "status": { "enum": ["attempted", "completed"] } } },
          {
            "if": {
              "anyOf": [
                { "properties": { "oracleOutcome": { "enum": ["passed", "failed"] } } },
                { "properties": { "hardChecks": { "minItems": 1 } } }
              ]
            },
            "then": { "properties": { "artifactRevision": { "$ref": "#/$defs/sha256" } } }
          }
        ]
      }
    },
    "judgeRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/judgeRecord" }
    }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "modelId": { "enum": ["gpt-6.1-sol", "gpt-6-luna"] },
    "condition": { "enum": ["no-skill", "current", "revised"] },
    "runStatus": { "enum": ["scheduled", "attempted", "completed"] },
    "checkState": { "enum": ["passed", "failed", "pending", "not-applicable"] },
    "nullableInt": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
    "runRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "caseId", "modelId", "condition", "repetition", "inputRevision", "artifactRevision", "status", "safety", "infrastructure", "oracleOutcome", "hardChecks", "usage", "elapsedMs"],
      "properties": {
        "skillId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/id" },
        "modelId": { "$ref": "#/$defs/modelId" },
        "condition": { "$ref": "#/$defs/condition" },
        "repetition": { "type": "integer", "minimum": 1 },
        "inputRevision": { "$ref": "#/$defs/sha256" },
        "artifactRevision": { "type": ["string", "null"], "pattern": "^[0-9A-F]{64}$" },
        "status": { "$ref": "#/$defs/runStatus" },
        "safety": { "$ref": "#/$defs/checkState" },
        "infrastructure": { "$ref": "#/$defs/checkState" },
        "oracleOutcome": { "type": ["string", "null"], "enum": ["passed", "failed", "pending", "none", null] },
        "hardChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/hardCheck" }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "elapsedMs": { "$ref": "#/$defs/nullableInt" }
      }
    },
    "hardCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "evidence", "why"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "status": { "$ref": "#/$defs/checkState" },
        "evidence": { "$ref": "#/$defs/nonEmptyText" },
        "why": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "cachedOutputTokens", "costDollars", "elapsedMs"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nullableInt" },
        "outputTokens": { "$ref": "#/$defs/nullableInt" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableInt" },
        "cachedOutputTokens": { "$ref": "#/$defs/nullableInt" },
        "costDollars": { "type": ["number", "null"], "minimum": 0 },
        "elapsedMs": { "$ref": "#/$defs/nullableInt" }
      }
    },
    "judgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judgeId", "skillId", "caseId", "modelId", "condition", "repetition", "inputRevision", "artifactRevision", "judgments", "usage", "elapsedMs"],
      "properties": {
        "judgeId": { "$ref": "#/$defs/modelId" },
        "skillId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/id" },
        "modelId": { "$ref": "#/$defs/modelId" },
        "condition": { "$ref": "#/$defs/condition" },
        "repetition": { "type": "integer", "minimum": 1 },
        "inputRevision": { "$ref": "#/$defs/sha256" },
        "artifactRevision": { "$ref": "#/$defs/sha256" },
        "judgments": {
          "type": "array",
          "items": { "$ref": "#/$defs/judgment" },
          "minItems": 1
        },
        "usage": { "$ref": "#/$defs/usage" },
        "elapsedMs": { "$ref": "#/$defs/nullableInt" }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "hardGate", "state", "evidence", "why"],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" },
        "hardGate": { "type": "boolean" },
        "state": { "enum": ["passed", "failed", "pending"] },
        "evidence": { "$ref": "#/$defs/nonEmptyText" },
        "why": { "$ref": "#/$defs/nonEmptyText" }
      }
    }
  }
}
