{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "artifactTargets", "suppliedFacts", "requiredClaims", "forbiddenClaims", "literalChecks", "rubricRefs", "ledger"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "enum": ["pr-description", "review-comment", "decision"] },
    "artifactTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "enum": ["last-message", "file"] },
          "path": { "$ref": "#/$defs/text" }
        },
        "if": { "properties": { "source": { "const": "file" } } },
        "then": { "required": ["path"] },
        "else": { "not": { "required": ["path"] } }
      }
    },
    "suppliedFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "state", "kind", "provenance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "$ref": "#/$defs/text" },
          "state": { "enum": ["verified", "inference", "hypothesis", "unknown"] },
          "kind": { "enum": ["fact", "ownership", "commitment", "permission"] },
          "provenance": { "const": "scenario-input" }
        }
      }
    },
    "requiredClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targetId", "text", "factRefs", "verbatimTokens"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "targetId": { "$ref": "#/$defs/id" },
          "text": { "$ref": "#/$defs/text" },
          "factRefs": { "$ref": "#/$defs/refs" },
          "verbatimTokens": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "forbiddenClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targetId", "text", "kind", "factRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "targetId": { "$ref": "#/$defs/id" },
          "text": { "$ref": "#/$defs/text" },
          "kind": { "enum": ["completion", "regression", "ownership", "commitment", "test-status", "certainty-upgrade", "publication-action", "over-hardening", "other"] },
          "factRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "literalChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targetId", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "targetId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["nonempty", "heading", "starts-with", "contains-literal", "forbids-literal", "single-line-paragraphs"] },
          "text": { "$ref": "#/$defs/text" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["heading", "starts-with", "contains-literal", "forbids-literal"] } } },
            "then": { "required": ["text"] },
            "else": { "not": { "required": ["text"] } }
          },
          {
            "if": { "properties": { "kind": { "const": "heading" } } },
            "then": { "required": ["level"] },
            "else": { "not": { "required": ["level"] } }
          }
        ]
      }
    },
    "rubricRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "revision", "itemIds"],
        "properties": {
          "path": { "$ref": "#/$defs/text" },
          "revision": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "itemIds": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["off", "diagnostic", "required"] },
        "targetId": { "$ref": "#/$defs/id" },
        "format": { "const": "grounding-ledger/v1" }
      },
      "if": { "properties": { "mode": { "const": "off" } } },
      "then": { "not": { "anyOf": [{ "required": ["targetId"] }, { "required": ["format"] }] } },
      "else": { "required": ["targetId", "format"] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
