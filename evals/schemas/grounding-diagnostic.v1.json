{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceMode", "coverage", "bankId", "bankRevision", "assetRevision", "groundingRevision", "modelId", "modelRevision", "backend", "reviewEvidence", "probeCount", "usefulPassedCount", "usefulOutcome", "calibrationStatus", "probes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceMode": { "const": "grounding-diagnostic" },
    "coverage": { "const": "explicit-development-probes-only" },
    "bankId": { "$ref": "#/$defs/text" },
    "bankRevision": { "$ref": "#/$defs/revision" },
    "assetRevision": { "$ref": "#/$defs/revision" },
    "groundingRevision": { "$ref": "#/$defs/revision" },
    "modelId": { "$ref": "#/$defs/text" },
    "modelRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "synthetic", "revision", "runtime", "tokenizer"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "synthetic": { "type": "boolean" },
        "revision": { "$ref": "#/$defs/revision" },
        "runtime": { "$ref": "#/$defs/text" },
        "tokenizer": { "$ref": "#/$defs/text" }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "sourceRevision", "bankRevision", "authorityScope", "labels"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/text" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "bankRevision": { "$ref": "#/$defs/revision" },
        "authorityScope": { "enum": ["synthetic-review-fixture", "declared-human-reviewed-development"] },
        "labels": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "probeCount": { "type": "integer", "minimum": 1 },
    "usefulPassedCount": { "const": 0 },
    "usefulOutcome": { "const": "pending" },
    "calibrationStatus": { "const": "pending" },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "tokenCount", "scores", "qualityStatus", "reviewedRelation", "matchesReviewedRelation", "elapsedMilliseconds"],
        "properties": {
          "input": { "type": "object" },
          "tokenCount": { "type": "integer", "minimum": 4, "maximum": 512 },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logits", "contradiction", "entailment", "neutral", "rawRelation"],
            "properties": {
              "logits": {
                "type": "object",
                "additionalProperties": false,
                "required": ["contradiction", "entailment", "neutral"],
                "properties": {
                  "contradiction": { "type": "number" },
                  "entailment": { "type": "number" },
                  "neutral": { "type": "number" }
                }
              },
              "contradiction": { "$ref": "#/$defs/score" },
              "entailment": { "$ref": "#/$defs/score" },
              "neutral": { "$ref": "#/$defs/score" },
              "rawRelation": { "enum": ["entailed", "contradicted", "neutral", null] }
            }
          },
          "qualityStatus": { "const": "pending" },
          "reviewedRelation": { "enum": ["entailed", "contradicted", "neutral"] },
          "matchesReviewedRelation": { "type": ["boolean", "null"] },
          "elapsedMilliseconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
