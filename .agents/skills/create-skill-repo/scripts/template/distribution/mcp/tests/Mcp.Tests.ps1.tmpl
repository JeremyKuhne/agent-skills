#Requires -Version 7.4
#Requires -Modules @{ ModuleName = 'Pester'; ModuleVersion = '6.2.0' }

Describe 'MCP manifest' {
    It 'uses the typed server collection shape' {
        $root = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
        $manifest = Get-Content (Join-Path $root '.mcp.json') -Raw |
            ConvertFrom-Json
        $manifest.PSObject.Properties.Name | Should -Contain 'mcpServers'
        foreach ($property in $manifest.mcpServers.PSObject.Properties) {
            @('http', 'stdio') | Should -Contain $property.Value.type
        }
    }
}